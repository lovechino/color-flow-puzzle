{
  "name": "color-flow-puzzle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate": "npx tsx scripts/generate-all-levels.ts",
    "pre-generate": "npx tsx scripts/pre-generate-levels.ts",
    "pre-generate:grid6": "npx tsx scripts/pre-generate-levels.ts --grid 6",
    "validate": "npx tsx scripts/validate-all-levels.ts",
    "test": "npx tsx scripts/run-tests.ts",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "verify": "npx tsx scripts/verify-level.ts --all"
  },
  "dependencies": {
    "@types/howler": "^2.2.12",
    "howler": "^2.2.4",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@vitest/ui": "^2.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^2.0.0"
  }
}
